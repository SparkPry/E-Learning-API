DB_HOST=mysql.railway.internal   # copy value of MYSQLHOST
DB_PORT=3306                          # copy value of MYSQLPORT
DB_USER=root                       # copy value of MYSQLUSER
DB_PASSWORD=your_secure_password_here # IMPORTANT: Replace with actual credentials in production
DB_NAME=railway                         # copy value of MYSQLDATABASE
# Generate strong JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_minimum_32_characters
